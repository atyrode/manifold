# manifold public vhost — example Caddy block for host-proxy deployments.
#
# Copy next to your host's Caddy configuration (or `import` it from the main
# Caddyfile) and set MANIFOLD_DOMAIN in Caddy's environment to the public
# domain. It must match MANIFOLD_DOMAIN in the compose `.env`, which feeds
# MANIFOLD_PUBLIC_URL.
#
# The manifold server binds 127.0.0.1:7777 (MANIFOLD_BIND default), so this
# proxy is the only public entrance. Caddy v2's reverse_proxy forwards
# WebSocket upgrades natively, which is what /ws/session and /ws/machine need.

{$MANIFOLD_DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	reverse_proxy 127.0.0.1:7777
}
