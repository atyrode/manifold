# manifold public vhost — https://manifold.tyrode.dev
#
# Installed to /var/www/manifold/Caddyfile and pulled in by a single additive
# `import` line at the end of the host's main Caddyfile, matching the existing
# per-site convention there. Keeping the block in this repo means manifold's
# public surface is versioned with the code it serves.
#
# The manifold server binds 127.0.0.1:7777 (MANIFOLD_BIND default), so this
# proxy is the only public entrance. Caddy v2's reverse_proxy forwards
# WebSocket upgrades natively, which is what /ws/session and /ws/machine need.

manifold.tyrode.dev {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	reverse_proxy 127.0.0.1:7777
}

# Browser VNC bridge for the manifold-os KVM guest on WSL. QEMU and websockify
# stay loopback-only behind the restricted reverse SSH tunnel; the public
# boundary accepts only short-lived manifold cookies.
vm.manifold.tyrode.dev {
	encode zstd gzip

	header {
		Content-Security-Policy "frame-ancestors https://manifold.tyrode.dev"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
	}

	forward_auth 127.0.0.1:7777 {
		uri /api/vm/authorize
	}

	@root path /
	redir @root /vnc.html?autoconnect=1&resize=scale&host=vm.manifold.tyrode.dev&port=443&encrypt=1&compression=2&reconnect=1&reconnect_delay=1000

	reverse_proxy 127.0.0.1:16080
}
