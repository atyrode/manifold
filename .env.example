# Copy to .env and edit. Consumed by `docker compose up -d --build`.

# REQUIRED. Public origin of this hub; a DNS A record must point here.
# `localhost` works for smoke tests (Caddy then uses its internal CA).
MANIFOLD_DOMAIN=manifold.example.com

# Machine name of the hub's own in-container terminal agent (default: hub).
#MANIFOLD_MACHINE_NAME=hub

# Optional: pin the owner key (64 hex chars) instead of generating one at
# /data/owner.key on first boot. Never commit a real key.
#MANIFOLD_OWNER_KEY=

# Optional: run a published image instead of building from this checkout
# (tags: https://github.com/atyrode/manifold/releases; there is no `latest`).
#MANIFOLD_IMAGE=ghcr.io/atyrode/manifold:v0.6.1

# Optional: "0" retires the in-container terminal agent (its shells live in
# the container; sensible where the container's disk is ephemeral).
#MANIFOLD_SPAWN_AGENT=1

# Optional: replicate manifold.db continuously to any S3-compatible store and
# restore from it when the local file is absent (docs/SELF-HOST.md
# §Replicate the database). All four are required together.
#MANIFOLD_REPLICA_BUCKET=
#MANIFOLD_REPLICA_ENDPOINT=https://s3.example.com
#LITESTREAM_ACCESS_KEY_ID=
#LITESTREAM_SECRET_ACCESS_KEY=
