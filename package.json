{
  "name": "manifold",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.13"
  },
  "scripts": {
    "check": "tsc -p packages/protocol && tsc -p packages/sdk && tsc -p packages/server && tsc -p packages/agent && tsc -p packages/testkit && tsc -p packages/web && tsc -p tsconfig.scripts.json",
    "test": "bun test packages/protocol packages/sdk packages/server packages/agent packages/web",
    "e2e": "bun test packages/testkit --timeout 60000",
    "verify:convergence": "bun scripts/verify-convergence.ts",
    "verify:public": "bun scripts/verify-public.ts",
    "verify:terminal-selection": "bun scripts/verify-terminal-selection.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:server": "bun --watch packages/server/src/main.ts",
    "dev:web": "bun run --cwd packages/web dev",
    "build:web": "bun run --cwd packages/web build",
    "gate": "bun run check && bun run lint && bun run format:check && bun run test && bun run e2e && bun run verify:convergence"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/bun": "^1.3.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "patchedDependencies": {
    "@excalidraw/excalidraw@0.18.1": "patches/@excalidraw%2Fexcalidraw@0.18.1.patch",
    "@xterm/xterm@6.0.0": "patches/@xterm%2Fxterm@6.0.0.patch"
  }
}
