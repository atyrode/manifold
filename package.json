{
  "name": "manifold",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.13"
  },
  "scripts": {
    "check": "tsc -p packages/protocol && tsc -p packages/sdk && tsc -p packages/server && tsc -p packages/agent && tsc -p packages/testkit && tsc -p packages/web",
    "test": "bun test packages",
    "e2e": "bun test packages/testkit/e2e --timeout 30000",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:server": "bun --watch packages/server/src/main.ts",
    "dev:web": "bun run --cwd packages/web dev",
    "build:web": "bun run --cwd packages/web build",
    "gate": "bun run check && bun run lint && bun run format:check && bun test packages && bun run e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/bun": "^1.3.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
